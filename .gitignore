# Entorno y caché de Python
.venv/
__pycache__/
*.pyc

# Configuración local de cada equipo (plantilla: .env.example)
.env

# Generado en ejecución
temp/*
!temp/.gitkeep
output/*
!output/.gitkeep
bin/
*.log

