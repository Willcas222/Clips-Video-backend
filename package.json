{
  "name": "tiktok-assistant-backend",
  "version": "1.0.0",
  "description": "API local (Arquitectura Hexagonal) para automatizar contenido de redes sociales",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "serve": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "workers:setup": "cd ai-workers && py -3.12 -m venv .venv && .venv\\Scripts\\python -m pip install -r requirements.txt"
  },
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "multer": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true
  },
  "private": true
}
