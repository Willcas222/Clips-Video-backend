# Copia este archivo como .env y ajusta lo que necesites. "auto" = detección automática.

# --- IA de análisis (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Equipo con GPU de 8 GB+ o 16 GB+ de RAM: modelos mayores eligen mejor los clips
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_MODEL=llama3.1
MAX_TRANSCRIPT_CHARS=40000

# --- Transcripción (faster-whisper) ---
WHISPER_MODEL=small
# Con GPU NVIDIA puedes subir a medium o large-v3 (más precisos)
# WHISPER_MODEL=large-v3
WHISPER_BEAM_SIZE=1
WHISPER_DEVICE=auto
WHISPER_CPU_THREADS=0
TRANSCRIBE_CHUNK_SECONDS=auto
WHISPER_KEEP_LOADED=0

# --- Render ---
VIDEO_ENCODER=auto
# 3500k ≈ 13 MB por short de 30 s; súbelo (p. ej. 6000k) si quieres más nitidez
VIDEO_BITRATE=3500k
NUM_CLIPS=3
# Duración máxima aceptada y análisis por bloques de la IA
MAX_VIDEO_HOURS=12
ANALYSIS_CHUNK_MINUTES=15
ANALYSIS_OVERLAP_MINUTES=1
AUDIO_PITCH=1.03

# --- Varios ---
CLEANUP_TEMP=1
