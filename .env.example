# Copia este archivo como .env y ajusta lo que necesites. "auto" = detección automática.

# --- IA de análisis (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
# auto = el mayor modelo que cabe en este equipo y está descargado (7b con 16 GB o GPU 8 GB+, si no 3b)
OLLAMA_MODEL=auto
# OLLAMA_MODEL=qwen2.5:7b
MAX_TRANSCRIPT_CHARS=40000

# --- Transcripción (faster-whisper) ---
# auto = small en CPU; medium o large-v3 con GPU NVIDIA según su VRAM
WHISPER_MODEL=auto
# WHISPER_MODEL=large-v3
WHISPER_BEAM_SIZE=1
WHISPER_DEVICE=auto
WHISPER_CPU_THREADS=0
TRANSCRIBE_CHUNK_SECONDS=auto
# auto = mantener Whisper en memoria entre tareas si hay 16 GB de RAM o GPU
WHISPER_KEEP_LOADED=auto

# --- Render ---
VIDEO_ENCODER=auto
# 3500k ≈ 13 MB por short de 30 s; súbelo (p. ej. 6000k) si quieres más nitidez
VIDEO_BITRATE=3500k
NUM_CLIPS=3
# Duración máxima aceptada y análisis por bloques de la IA
MAX_VIDEO_HOURS=12
ANALYSIS_CHUNK_MINUTES=15
ANALYSIS_OVERLAP_MINUTES=1
AUDIO_PITCH=1.03

# --- Varios ---
# auto = prioridad por debajo de lo normal (el equipo sigue usable mientras procesa) | normal
PROCESS_PRIORITY=auto
CLEANUP_TEMP=1
