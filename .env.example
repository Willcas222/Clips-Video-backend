PORT=3001
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_BASE_URL=http://localhost:3001
MAX_UPLOAD_MB=1024

OLLAMA_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT_MS=600000
# 0 = liberar RAM tras cada llamada (recomendado con menos de 16 GB). Ej. 5m para mantenerlo cargado.
OLLAMA_KEEP_ALIVE=0

# Ruta al intérprete de Python (por defecto usa el venv de ai-workers)
PYTHON_BIN=
WORKER_TIMEOUT_MS=1800000
WHISPER_MODEL=small

# Opcional: binarios propios; por defecto se usan ffmpeg-static / ffprobe-static
FFMPEG_PATH=
FFPROBE_PATH=

# Música en tendencia de TikTok (consulta Deezer; solo títulos, nunca tus archivos). off = catálogo local
MUSIC_TRENDS=on
